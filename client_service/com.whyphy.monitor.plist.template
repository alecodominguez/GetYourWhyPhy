<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Template used by `python passive_monitor.py install` on macOS - not meant to
be installed by hand. The installer fills in {{PYTHON}}, {{SCRIPT}} and
{{LOG_DIR}}, writes the result to ~/Library/LaunchAgents/com.whyphy.monitor.plist
and runs `launchctl load -w` on it.

RunAtLoad + KeepAlive: start at every login, and restart if it crashes.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.whyphy.monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON}}</string>
        <string>{{SCRIPT}}</string>
        <string>run</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/whyphy-monitor.log</string>
    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/whyphy-monitor.err.log</string>
</dict>
</plist>
